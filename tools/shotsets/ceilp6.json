[{"name":"cp6","cam":[-86.0,1.7,-30],"look":[-86.0,3.4,-30],"fov":90,"hour":11,
 "exec":"(()=>{const T=window.THREE,S=window.__app.scene;let m=null;S.traverse(o=>{if(o.name==='main:ceilingBoard')m=o;});m.updateWorldMatrix(true,false);const p=m.geometry.attributes.position;const v=new T.Vector3();let wzmin=1e9,wzmax=-1e9,ymin=1e9,ymax=-1e9,xmin=1e9,xmax=-1e9;for(let i=0;i<p.count;i++){v.fromBufferAttribute(p,i).applyMatrix4(m.matrixWorld);wzmin=Math.min(wzmin,v.z);wzmax=Math.max(wzmax,v.z);ymin=Math.min(ymin,v.y);ymax=Math.max(ymax,v.y);xmin=Math.min(xmin,v.x);xmax=Math.max(xmax,v.x);}return JSON.stringify({worldZ:[+wzmin.toFixed(1),+wzmax.toFixed(1)],worldX:[+xmin.toFixed(1),+xmax.toFixed(1)],worldY:[+ymin.toFixed(1),+ymax.toFixed(1)],parent:m.parent&&m.parent.name,parentPos:m.parent?m.parent.position.toArray():null})})()"}]
