 "exec":"(()=>{const T=window.THREE,S=window.__app.scene;const out={};S.traverse(o=>{if(!o.name||!o.name.startsWith('main:'))return;const k=o.name.slice(5);if(!/^(tileRed|classroomFloor|deskTop|interiorPlaster|chalkboard|ceilingBoard)$/.test(k))return;o.updateWorldMatrix(true,false);const p=o.geometry.attributes.position;const v=new T.Vector3();let r={x:[1e9,-1e9],y:[1e9,-1e9],z:[1e9,-1e9]};for(let i=0;i<p.count;i++){v.fromBufferAttribute(p,i).applyMatrix4(o.matrixWorld);r.x[0]=Math.min(r.x[0],v.x);r.x[1]=Math.max(r.x[1],v.x);r.y[0]=Math.min(r.y[0],v.y);r.y[1]=Math.max(r.y[1],v.y);r.z[0]=Math.min(r.z[0],v.z);r.z[1]=Math.max(r.z[1],v.z);}out[k]={x:r.x.map(f=>+f.toFixed(1)),z:r.z.map(f=>+f.toFixed(1)),y:r.y.map(f=>+f.toFixed(1))};});return JSON.stringify(out)})()"}]
