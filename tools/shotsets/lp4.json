 "exec":"(()=>{const T=window.THREE,S=window.__app.scene;const o=[];S.traverse(m=>{if(m.name==='main:concreteTrim'&&m.geometry){m.geometry.computeBoundingBox();const bb=m.geometry.boundingBox.clone().applyMatrix4(m.matrixWorld);if(Math.abs((bb.min.x+bb.max.x)/2+80)<8){o.push('concreteTrim x'+bb.min.x.toFixed(1)+'..'+bb.max.x.toFixed(1)+' y'+bb.min.y.toFixed(2)+'..'+bb.max.y.toFixed(2)+' z'+bb.min.z.toFixed(1)+'..'+bb.max.z.toFixed(1));}}});return JSON.stringify(o.slice(0,12))})()"}]
